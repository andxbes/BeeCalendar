{
  "name": "beecalendar",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "android:prebuild": "expo prebuild --platform android",
    "android:prebuild:clean": "expo prebuild --platform android --clean",
    "android:run": "expo run:android",
    "android:run:release": "expo run:android --variant release",
    "android:apk:debug": "cd android && ./gradlew app:assembleDebug",
    "android:apk:release": "cd android && ./gradlew app:assembleRelease",
    "android:build": "npm run android:prebuild && npm run android:run",
    "android:build:release": "npm run android:prebuild && npm run android:run:release"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/elements": "^2.9.19",
    "@react-navigation/native": "^7.2.5",
    "expo": "^56.0.8",
    "expo-constants": "^56.0.16",
    "expo-device": "^56.0.4",
    "expo-font": "^56.0.5",
    "expo-haptics": "^56.0.3",
    "expo-image": "^56.0.9",
    "expo-linking": "^56.0.13",
    "expo-notifications": "^56.0.15",
    "expo-router": "^56.2.8",
    "expo-splash-screen": "^56.0.10",
    "expo-status-bar": "^56.0.4",
    "expo-symbols": "^56.0.5",
    "expo-system-ui": "^56.0.5",
    "expo-web-browser": "^56.0.5",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^3.0.0",
    "react-native-reanimated": "^4.4.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "typescript": "^6.0.3",
    "eslint": "^10.4.1",
    "eslint-config-expo": "^56.0.4"
  },
  "private": true
}
